# Production environment — copy to .env.prod and fill in real values
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=ycaohoahong.com,www.ycaohoahong.com

# Database (PostgreSQL + pgvector)
# NOTE: docker-compose env_file does NOT expand ${VARS}. Write DATABASE_URL in full.
# Keep POSTGRES_USER/PASSWORD/DB in sync with DATABASE_URL below.
POSTGRES_DB=quanlybenhnhan
POSTGRES_USER=quanlybenhnhan
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://quanlybenhnhan:CHANGE_ME_STRONG_PASSWORD@db:5432/quanlybenhnhan

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://ycaohoahong.com,https://www.ycaohoahong.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://ycaohoahong.com,https://www.ycaohoahong.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Static & Media
STATIC_URL=/khamsk/static/
MEDIA_URL=/khamsk/media/
MEDIA_ROOT=/app/src/media

# Clinic identity (dùng trong template báo cáo: {{ clinic_name }} ...)
CLINIC_NAME=PHÒNG KHÁM ĐA KHOA Y CAO HOA HỒNG
CLINIC_ADDRESS=Tổ Dân Phố Đông Hải - Phường Duy Hải - Thị Xã Duy Tiên - Tỉnh Hà Nam
CLINIC_PHONE=0788.688.333
CLINIC_EMAIL=
CLINIC_WEBSITE=https://ycaohoahong.com/

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
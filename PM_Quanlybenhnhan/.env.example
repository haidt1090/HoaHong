# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=generate-with-python3--c-import-secrets;print(secrets.token_hex(32))
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL + pgvector)
POSTGRES_DB=quanlybenhnhan
POSTGRES_USER=quanlybenhnhan
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Static & Media
STATIC_URL=/khamsk/static/
MEDIA_URL=/khamsk/media/
MEDIA_ROOT=/app/media

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Clinic identity (dùng trong template báo cáo: {{ clinic_name }} ...)
CLINIC_NAME=PHÒNG KHÁM ĐA KHOA Y CAO HOA HỒNG
CLINIC_ADDRESS=
CLINIC_PHONE=0788688333
CLINIC_EMAIL=
CLINIC_WEBSITE=
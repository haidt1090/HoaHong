{
  "name": "inbaocao",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/*.test.js desktop/*.test.js",
    "start": "node server.js",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src tests server.js playwright.config.js",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && npm run prepare:desktop && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && npm run prepare:desktop && electron-builder --linux dir --publish never",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "prepare:desktop": "node scripts/prepare-desktop.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "description": "In sổ khám sức khỏe khổ A3 hàng loạt từ danh sách Excel",
  "author": "HoaHong",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "vn.hoahong.inbaocao",
    "productName": "InBaoCao",
    "asar": true,
    "directories": {
      "output": "release",
      "app": ".desktop-package"
    },
    "files": [
      "dist/**/*",
      "desktop/main.mjs",
      "desktop/paths.js",
      "word-converter.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "InBaoCao-${version}-${arch}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InBaoCao",
      "deleteAppDataOnUninstall": false,
      "script": "build/installer.nsi",
      "installerLanguages": [
        "vi_VN"
      ],
      "language": "1066"
    },
    "portable": {
      "artifactName": "InBaoCao-${version}-x64-Portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haidt1090/HoaHong.git",
    "directory": "InBaoCao"
  }
}
